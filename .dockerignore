__pycache__/
*.pyc
*.pyo
*.pyd
.Python
backend/venv/

# Environment files
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Git
.git/
.gitignore

# Build outputs (frontend will be built separately)
frontend/dist/
frontend/build/

# Never ship databases, SQLite sidecars, or backups in the image context.
*.db
**/*.db
*.db-*
**/*.db-*
*.db.*
**/*.db.*
*.sqlite*
**/*.sqlite*
data/backups/

# Local secrets, dependency trees, and deployment/test artifacts at any depth.
.env.*
**/.env
**/.env.*
**/*.env
.venv/
**/.venv/
venv/
**/venv/
.vercel/
**/.vercel/
**/node_modules/
**/__pycache__/
**/test-results/
**/playwright-report/

# Images (too large, should be in volume or CDN)
data/images/

# Testing
.pytest_cache/
coverage/
.coverage
htmlcov/

# Documentation (not needed in container)
*.md
!README.md
